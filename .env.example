# Copy to .env.local for local dev, or set these as environment variables
# in your hosting provider's dashboard for a live deployment.

# Where the SQLite file lives. Leave unset for local dev (defaults to
# ./data). In production, point this at a mounted persistent volume, e.g.
# DATA_DIR=/data on Railway/Fly.io — otherwise the database resets on every
# deploy/restart.
# DATA_DIR=/data

# Shared login for the whole app (HTTP Basic Auth via middleware.ts).
# REQUIRED before this goes live anywhere public — this CRM stores real
# names, phone numbers, DOB, and (masked-by-default but present) SSN and
# bank/routing info, and has no other login system.
# BASIC_AUTH_USER=your-username
# BASIC_AUTH_PASSWORD=choose-a-strong-password

# Railway/most hosts set PORT for you automatically — no action needed.
# PORT=3000
