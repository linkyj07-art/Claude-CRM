# Copy to .env.local for local dev, or set these as environment variables
# in your hosting provider's dashboard for a live deployment.

# Where the SQLite file lives. Leave unset for local dev (defaults to
# ./data). In production, point this at a mounted persistent volume, e.g.
# DATA_DIR=/data on Railway/Fly.io — otherwise the database resets on every
# deploy/restart.
# DATA_DIR=/data

# Shared login for the whole app (HTTP Basic Auth via middleware.ts).
# REQUIRED before this goes live anywhere public — this CRM stores real
# names, phone numbers, DOB, SSN, and bank/routing info in full (unmasked,
# since Basic Auth is the only gate), and has no other login system.
# BASIC_AUTH_USER=your-username
# BASIC_AUTH_PASSWORD=choose-a-strong-password

# Optional: your app.insurancetoolkits.com account token, used to skip
# logging in each time the "Run Quote" button opens the FEX Lite quoter.
# Leave unset to open the quoter without a token pre-filled.
# INSURANCE_TOOLKIT_TOKEN=your-token-here

# Railway/most hosts set PORT for you automatically — no action needed.
# PORT=3000

# Shared secret for the incoming-call webhook (/api/webhooks/incoming-call).
# Required only if you set up live incoming-call detection (see README
# "Incoming call popup"). Generate any long random string, e.g.
# `openssl rand -hex 24`. This same value also goes into CRM_BASE_URL/
# QUO_WEBHOOK_TOKEN below on your Mac (scripts/quo-helper-server.js) — it's
# one shared secret used in two places, not two different tokens.
# QUO_WEBHOOK_TOKEN=

# Goat Leads webhook (/api/webhooks/leads/goat) — auto-creates a lead the
# moment Goat delivers one, instead of a manual CSV import. Required only if
# you set this up (see README "Goat Leads webhook"). Generate a token the
# same way as above (`openssl rand -hex 24`) and paste the full URL —
# https://<your-crm-domain>/api/webhooks/leads/goat?token=<that value> —
# into Goat Leads' webhook/integration settings.
# GOAT_LEADS_WEBHOOK_TOKEN=
# The username (not display name) of the account new Goat leads should be
# assigned to.
# GOAT_LEADS_OWNER_USERNAME=
